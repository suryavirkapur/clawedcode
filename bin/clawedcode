#!/usr/bin/env node
const { spawnSync } = require('child_process');
const fs = require('fs');
const path = require('path');

const ext = process.platform === 'win32' ? '.exe' : '';
const binPath = path.join(__dirname, `clawedcode-bin${ext}`);

function hasUsableBinary(p) {
  try {
    const st = fs.statSync(p);
    return st.isFile() && st.size > 0;
  } catch {
    return false;
  }
}

if (!hasUsableBinary(binPath)) {
  const installer = path.join(__dirname, '..', 'install.js');
  const res = spawnSync(process.execPath, [installer], { stdio: 'inherit' });
  if (res.status !== 0) process.exit(res.status ?? 1);
}

const res = spawnSync(binPath, process.argv.slice(2), { stdio: 'inherit' });
process.exit(res.status ?? 1);
